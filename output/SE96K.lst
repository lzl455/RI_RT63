  0069B4  9FDE				movar	0xDE,1
  0069B6  0BDE				decr	0xDE,1,1
  0069B8  50D8				jbts1	0xD8,0,0
  0069BA  0BDF				decr	0xDF,1,1
  0069BC  A1DE				movr	0xDE,0,1
  0069BE  21DF				orar	0xDF,0,1
  0069C0  D1FA				rjbnz	0xFA
49:				        while(--i);
50:				    }
51:				    while(--time);
  0069C2  1FDD				djzr	0xDD,1,1
  0069C4  E7F3				rgoto	0x7F3
