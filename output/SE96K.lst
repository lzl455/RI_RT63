53:				
54:				/******************************************************************************
55:				* 函数名称: delayus()
56:				* 功能描述: 微秒延时
57:				* 输入参数: 延时时间
58:				* 输出参数: 无
59:				* 说    明: 单位：1us；最大：256微秒；额外开销3.4us
60:				******************************************************************************/
61:				void delayus(unsigned char time)
62:				{
63:				    while(--time);
64:				}
